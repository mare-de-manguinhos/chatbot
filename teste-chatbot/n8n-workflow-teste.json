                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Retornar JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [800, 0]
    },
    {
      "parameters": {
        "content": "## Workflow de Teste — teste-chatbot\n\n**Como usar:**\n1. Ative este workflow no n8n\n2. Configure as credenciais do Google Gemini nos nós indicados\n3. A URL do webhook será: `<seu-n8n>/webhook/teste-audio`\n4. Registre essa URL no sistema teste-chatbot\n\n**Formato de entrada (POST):**\n```json\n{\n  \"audio_base64\": \"<base64 do arquivo .ogg>\",\n  \"nome_arquivo\": \"audio.ogg\"\n}\n```\n\n**Formato de saída:**\n```json\n{\n  \"transcricao\": \"texto transcrito...\",\n  \"pescador\": \"nome\",\n  \"peixe\": \"tipo\",\n  \"quantidade\": 5,\n  \"preco\": 10.50,\n  \"peso\": 2\n}\n```",
        "height": 340,
        "width": 400
      },
