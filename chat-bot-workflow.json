{
  "name": "Bot Pescadores - Transcrição de Áudio (Evolution + Gemini)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evolution",
        "options": {
          "rawBody": false
        }
      },
      "id": "dc697bf0-7663-402e-ab7d-275748ebd34d",
      "name": "Webhook Evolution API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -288,
        0
      ],
      "webhookId": "evolution"
    },
    {
      "parameters": {
        "jsCode": "// Filtra apenas mensagens de áudio recebidas\n// A Evolution API envia vários tipos de eventos\n\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const body = data.body || data;\n  \n  if (body.event !== 'messages.upsert') continue;\n  \n  const message = body?.data?.message;\n  const key = body?.data?.key;\n  \n  if (!message?.audioMessage) continue;\n  \n  // key.remoteJid = identificador do chat (pode ser LID ou número)\n  // Para responder, usamos o remoteJid completo (incluindo @lid se for o caso)\n  // O campo 'sender' na raiz é SEMPRE o número do bot, NÃO de quem mandou\n  const remoteJid = key.remoteJid; // ex: '123456@lid' ou '5527999@s.whatsapp.net'\n  \n  results.push({\n    json: {\n      messageId: key.id,\n      remoteJid: remoteJid,\n      pushName: body?.data?.pushName || 'Desconhecido',\n      instanceName: body?.instance || '',\n      audioSeconds: message.audioMessage.seconds || 0,\n      mimetype: message.audioMessage.mimetype || 'audio/ogg',\n      isPtt: message.audioMessage.ptt || false\n    }\n  });\n}\n\nif (results.length === 0) return [];\nreturn results;"
      },
      "id": "e9794c3b-0458-4056-a05c-2ef8725354ae",
      "name": "Filtrar Mensagens de Áudio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://bot-evolution:8080/chat/getBase64FromMediaMessage/{{ $json.instanceName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sua_chave_api_super_secreta"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {\n    \"key\": {\n      \"id\": \"{{ $json.messageId }}\"\n    }\n  },\n  \"convertToMp4\": false\n}",
        "options": {}
      },
      "id": "a5deb148-3463-4c87-80de-cfe7a5cc7449",
      "name": "Download Áudio (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Converte o áudio base64 retornado pela Evolution API em dados binários\n// para enviar ao Gemini\n\nconst item = $input.first();\nconst base64Data = item.json.base64;\nconst mimetype = item.json.mimetype || 'audio/ogg';\n\nif (!base64Data) {\n  throw new Error('Nenhum dado de áudio base64 encontrado na resposta da Evolution API. Verifique se DATABASE_SAVE_DATA_NEW_MESSAGE=true está configurado.');\n}\n\n// Preserva os dados do item anterior (messageId, remoteJid, etc.)\n// Precisamos pegar do nó \"Filtrar Mensagens de Áudio\"\nconst filtroData = $('Filtrar Mensagens de Áudio').first().json;\n\nreturn {\n  json: {\n    remoteJid: filtroData.remoteJid,\n    pushName: filtroData.pushName,\n    instanceName: filtroData.instanceName,\n    audioSeconds: filtroData.audioSeconds\n  },\n  binary: {\n    audio: {\n      data: base64Data,\n      mimeType: mimetype,\n      fileName: 'audio_pescador.ogg'\n    }\n  }\n};"
      },
      "id": "b7493f06-fc48-49e1-bf2b-5d99d1f73b29",
      "name": "Base64 → Binário",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ]
    },
    {
      "parameters": {
        "resource": "audio",
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.5-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "inputType": "binary",
        "binaryPropertyName": "audio",
        "options": {}
      },
      "id": "6468b473-7c7d-44f8-b06a-98e44377a96f",
      "name": "Gemini - Transcrever Áudio",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
