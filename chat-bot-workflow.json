        "googlePalmApi": {
          "id": "IRF1ZMsX0OAOpFpn",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://bot-evolution:8080/message/sendText/{{ $('Filtrar Mensagens de Áudio').first().json.instanceName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
