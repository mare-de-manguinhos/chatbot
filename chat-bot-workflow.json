        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Filtrar Mensagens de Áudio').first().json.remoteJid }}\",\n  \"text\": \"🎤 *Transcrição do seu áudio:*\\n\\n Pescador: {{ $json.output.pescador }} Peixe: {{ $json.output.peixe }} Quantidade: {{ $json.output.quantidade }} Preço:{{ $json.output.preco }} Peso:{{ $json.output.peso }}\\n\\n---\\n_Bot Pescadores Manguinhos - Protótipo_\"\n}",
        "options": {}
      },
